# ==========================================
# BioKey Master Gitignore
# ==========================================

# --- Python / Backend ---
# Virtual Environments
.venv/
venv/
ENV/
env/

# Python Cache & Compiled Files
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# --- Node.js / Frontend ---
# Dependencies
**/node_modules/
.pnpm-store/

# Production Builds
**/dist/
**/build/

# Log Files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Environment & Configuration Secrets ---
# Block all local text-based environment files
*.env
*.env.txt
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- IDEs and System Files ---
# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/

# Operating System Files
.DS_Store
Thumbs.db